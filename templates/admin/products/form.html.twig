{% extends 'admin/_layout.html.twig' %}

{% block title %}{{ title }} · Administration{% endblock %}
{% block admin_title %}{{ title }}{% endblock %}
{% block admin_actions %}<a href="{{ path('app_admin_products') }}" class="btn btn--sm btn--quiet">Retour aux produits</a>{% endblock %}
{% set admin_section = 'products' %}

{% block admin_body %}
{{ form_start(form) }}
{{ form_errors(form) }}
<div class="admin__cols admin__cols--form">
    <div>
        <section class="panel">
            <h2>Présentation</h2>
            {{ form_row(form.name) }}
            {{ form_row(form.description) }}
            {{ form_row(form.category) }}
        </section>
        <section class="panel">
            <h2>Image</h2>
            {{ form_row(form.imageFile, {help: 'JPG, PNG, WebP ou GIF, 5 Mo au plus. Prioritaire sur l\'adresse ci-dessous.'}) }}
            {{ form_row(form.image, {help: 'Adresse https d\'une image hébergée ailleurs.'}) }}
        </section>
    </div>
    <div>
        <section class="panel">
            <h2>Prix et stock</h2>
            {{ form_row(form.price) }}
            {{ form_row(form.oldPrice, {label: 'Ancien prix', help: 'S\'il est plus élevé que le prix, la réduction s\'affiche d\'elle-même.'}) }}
            {{ form_row(form.stock) }}
        </section>
        <section class="panel">
            <h2>Visibilité</h2>
            {{ form_row(form.isActive, {help: 'Décoché, le produit disparaît de la boutique sans être supprimé.'}) }}
            {{ form_row(form.isFeatured, {help: 'Exposé dans la vitrine de la page d\'accueil.'}) }}
        </section>
        <div class="form-actions">
            <button type="submit" class="btn">Enregistrer</button>
            <a href="{{ path('app_admin_products') }}" class="btn btn--quiet">Annuler</a>
        </div>
    </div>
</div>
{{ form_end(form) }}
{% endblock %}
