{% extends 'base.html.twig' %}

{% block title %}Binux Shop · La vitrine est allumée{% endblock %}
{% block body_class %}page-home{% endblock %}
{% block header_class %} site-header--night{% endblock %}

{% block body %}
<section class="vitrine" aria-labelledby="vitrine-titre" data-vitrine>
    <div class="wrap vitrine__head">
        <h1 class="enseigne" id="vitrine-titre">
            <span class="enseigne__tube enseigne__tube--blue">Binux</span>
            <span class="enseigne__tube enseigne__tube--orange">Shop</span>
        </h1>
        <p class="vitrine__lead">
            La vitrine est allumée. {{ product_count }} articles choisis avec soin,
            répartis dans {{ categories|length }} rayons, livrés sans frais.
        </p>
        <div class="vitrine__actions">
            <a class="btn btn--glow" href="{{ path('app_product_index') }}">Entrer dans la boutique</a>
            <a class="btn btn--on-night" href="#rayons">Parcourir les rayons</a>
        </div>
    </div>

    {% if featured_products|length > 0 %}
    <div class="vitrine__stage">
        <h2 class="sr-only">En vitrine en ce moment</h2>
        <ul class="rail" data-rail tabindex="0" aria-label="Articles en vitrine">
            {% for product in featured_products %}
            <li class="display display--{{ loop.index0 % 8 }}">
                <a class="display__link" href="{{ path('app_product_show', {slug: product.slug}) }}" data-product-link>
                    <span class="display__beam" aria-hidden="true"></span>
                    <span class="display__frame thumb thumb--night">
                        <span class="thumb__mono">{{ product.name|first|upper }}</span>
                        {% if product.imageUrl %}
                            <img src="{{ product.imageUrl }}" alt="" width="420" height="560" {% if loop.index > 4 %}loading="lazy"{% endif %} decoding="async" data-img>
                        {% endif %}
                    </span>
                    <span class="display__plate">
                        <span class="display__name">{{ product.name }}</span>
                        <span class="display__price">
                            {{ product.price|eur }}
                            {% if product.hasDiscount %}<s><span class="sr-only">au lieu de </span>{{ product.oldPrice|eur }}</s>{% endif %}
                        </span>
                    </span>
                </a>
            </li>
            {% endfor %}
        </ul>
        <div class="wrap rail-nav" data-rail-nav hidden>
            <button type="button" class="btn-round btn-round--night" data-rail-prev aria-label="Articles précédents">{{ icon('arrow-left') }}</button>
            <button type="button" class="btn-round btn-round--night" data-rail-next aria-label="Articles suivants">{{ icon('arrow-right') }}</button>
        </div>
    </div>
    {% endif %}
</section>

{% if categories|length > 0 %}
<section class="section rayons" id="rayons" aria-labelledby="rayons-titre">
    <div class="wrap rayons__grid">
        <div class="rayons__aside">
            <h2 id="rayons-titre">Le plan du magasin</h2>
            <p class="lead">Chaque rayon tient en quelques pièces. On en fait le tour en une minute.</p>
            <div class="rayons__preview thumb" data-rayon-preview aria-hidden="true">
                {% for row in categories %}
                    {% if row.category.imageUrl %}
                        <img src="{{ row.category.imageUrl }}" alt="" {% if not loop.first %}loading="lazy"{% endif %} decoding="async" width="640" height="480"
                             class="{{ loop.first ? 'is-active' }}" data-rayon-image="{{ loop.index0 }}" data-img>
                    {% endif %}
                {% endfor %}
            </div>
        </div>
        <ul class="rayons__list">
            {% for row in categories %}
            <li>
                <a class="rayon" href="{{ path('app_product_category', {slug: row.category.slug}) }}" data-rayon="{{ loop.index0 }}">
                    <span class="rayon__name">{{ row.category.name }}</span>
                    <span class="rayon__desc">{{ row.category.description }}</span>
                    <span class="rayon__count">{{ row.count }} article{{ row.count > 1 ? 's' }}</span>
                    {{ icon('arrow-up-right', 'rayon__arrow') }}
                </a>
            </li>
            {% endfor %}
        </ul>
    </div>
</section>
{% endif %}

{% if latest_products|length > 0 %}
<section class="section section--tint" aria-labelledby="nouveautes-titre">
    <div class="wrap">
        <div class="section__head">
            <div>
                <h2 id="nouveautes-titre">Derniers arrivages</h2>
                <p class="lead">Les pièces entrées le plus récemment au catalogue.</p>
            </div>
            <a class="link-more" href="{{ path('app_product_index') }}">Voir tous les articles</a>
        </div>
        <div class="grid-products">
            {% for product in latest_products %}
                {{ include('product/_card.html.twig', {product: product}) }}
            {% endfor %}
        </div>
    </div>
</section>
{% endif %}

<section class="section assurances" aria-label="Ce qui est compris">
    <div class="wrap assurances__grid">
        <div class="assurance">
            {{ icon('truck') }}
            <h2>Livraison offerte</h2>
            <p>Aucun frais de port n'est ajouté à votre commande, quel que soit son montant.</p>
        </div>
        <div class="assurance">
            {{ icon('lock') }}
            <h2>Paiement chez Stripe</h2>
            <p>Votre carte est saisie sur la page sécurisée de Stripe. La boutique ne la voit jamais.</p>
        </div>
        <div class="assurance">
            {{ icon('package') }}
            <h2>Stock réel</h2>
            <p>Un article affiché en stock vous est réservé dès que la commande est validée.</p>
        </div>
    </div>
</section>
{% endblock %}
