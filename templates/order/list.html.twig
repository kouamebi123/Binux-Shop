{% extends 'account/_layout.html.twig' %}

{% block title %}Mes commandes · Binux Shop{% endblock %}
{% block account_title %}Mes commandes{% endblock %}
{% set account_section = 'orders' %}

{% block account_body %}
    {% if orders|length > 0 %}
        <ul class="rows">
            {% for order in orders %}
            <li>
                <a class="row-card" href="{{ path('app_order_show', {id: order.id}) }}">
                    <span class="row-card__main">
                        <span class="order-number">{{ order.orderNumber }}</span>
                        <span class="row-card__meta">{{ order.createdAt|date('d/m/Y') }}, {{ order.items|length }} article{{ order.items|length > 1 ? 's' }}</span>
                    </span>
                    <span class="row-card__end">
                        {{ include('order/_status.html.twig') }}
                        <span class="amount">{{ order.total|eur }}</span>
                        {{ icon('chevron-right') }}
                    </span>
                </a>
            </li>
            {% endfor %}
        </ul>
    {% else %}
        <div class="empty">
            {{ icon('receipt') }}
            <h2>Aucune commande pour l'instant</h2>
            <p>Vos commandes apparaîtront ici dès la première validée.</p>
            <a href="{{ path('app_product_index') }}" class="btn">Voir les articles</a>
        </div>
    {% endif %}
{% endblock %}
