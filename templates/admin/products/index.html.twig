{% extends 'admin/_layout.html.twig' %}

{% block title %}Produits · Administration{% endblock %}
{% block admin_title %}Produits{% endblock %}
{% block admin_intro %}<p>{{ products|length }} produit{{ products|length > 1 ? 's' }} au catalogue.</p>{% endblock %}
{% block admin_actions %}<a href="{{ path('app_admin_product_add') }}" class="btn btn--sm">{{ icon('plus') }} Ajouter un produit</a>{% endblock %}
{% set admin_section = 'products' %}

{% block admin_body %}
<section class="panel panel--flush">
    {% if products|length > 0 %}
    <div class="table-wrap">
        <table class="table">
            <thead>
                <tr>
                    <th scope="col">Produit</th>
                    <th scope="col" class="num">Prix</th>
                    <th scope="col" class="num">Stock</th>
                    <th scope="col">État</th>
                    <th scope="col"><span class="sr-only">Actions</span></th>
                </tr>
            </thead>
            <tbody>
                {% for product in products %}
                <tr>
                    <td>
                        <div class="cell-product">
                            <span class="thumb thumb--sm">
                                <span class="thumb__mono">{{ product.name|first|upper }}</span>
                                {% if product.imageUrl %}<img src="{{ product.imageUrl }}" alt="" loading="lazy" data-img>{% endif %}
                            </span>
                            <div>
                                <a class="line__name" href="{{ path('app_admin_product_edit', {id: product.id}) }}">{{ product.name }}</a>
                                <p class="line__meta">{{ product.category.name }}{% if product.isFeatured %}, en vitrine{% endif %}</p>
                            </div>
                        </div>
                    </td>
                    <td class="num">{{ product.price|eur }}{% if product.hasDiscount %}<br><s class="muted">{{ product.oldPrice|eur }}</s>{% endif %}</td>
                    <td class="num">{% if product.stock == 0 %}<span class="tag tag--bad">0</span>{% elseif product.lowStock %}<span class="tag tag--warn">{{ product.stock }}</span>{% else %}{{ product.stock }}{% endif %}</td>
                    <td>{% if product.isActive %}<span class="tag tag--ok">En vente</span>{% else %}<span class="tag">Retiré</span>{% endif %}</td>
                    <td>
                        <div class="cell-actions">
                            <a href="{{ path('app_admin_product_edit', {id: product.id}) }}">Modifier</a>
                            <form method="post" action="{{ path('app_admin_product_delete', {id: product.id}) }}" data-confirm="Supprimer « {{ product.name }} » ?">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete_product_' ~ product.id) }}">
                                <button type="submit" class="link-button">Supprimer</button>
                            </form>
                        </div>
                    </td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
    {% else %}
    <div class="empty">
        {{ icon('package') }}
        <h2>Aucun produit</h2>
        <p>Ajoutez le premier article du catalogue.</p>
        <a href="{{ path('app_admin_product_add') }}" class="btn">Ajouter un produit</a>
    </div>
    {% endif %}
</section>
{% endblock %}
