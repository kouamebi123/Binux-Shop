{% extends 'admin/_layout.html.twig' %}

{% block title %}Commandes · Administration{% endblock %}
{% block admin_title %}Commandes{% endblock %}
{% block admin_intro %}<p>{{ orders|length }} commande{{ orders|length > 1 ? 's' }}{{ current_status ? ' dans cet état' }}.</p>{% endblock %}
{% set admin_section = 'orders' %}

{% block admin_body %}
<nav class="chips chips--bar" aria-label="Filtrer par état">
    <a class="chip" href="{{ path('app_admin_orders') }}" {{ current_status is null ? 'aria-current="page"' }}>Toutes</a>
    {% for key, label in available_statuses %}
        <a class="chip" href="{{ path('app_admin_orders', {statut: key}) }}" {{ current_status == key ? 'aria-current="page"' }}>{{ label }}</a>
    {% endfor %}
</nav>

<section class="panel panel--flush">
    {% if orders|length > 0 %}
    <div class="table-wrap">
        <table class="table">
            <thead>
                <tr>
                    <th scope="col">Commande</th>
                    <th scope="col">Client</th>
                    <th scope="col">État</th>
                    <th scope="col">Paiement</th>
                    <th scope="col" class="num">Total</th>
                </tr>
            </thead>
            <tbody>
                {% for order in orders %}
                <tr>
                    <td><a class="order-number" href="{{ path('app_admin_order_show', {id: order.id}) }}">{{ order.orderNumber }}</a><br><span class="muted">{{ order.createdAt|date('d/m/Y H:i') }}</span></td>
                    <td>{{ order.user.fullName }}<br><span class="muted">{{ order.user.email }}</span></td>
                    <td>{{ include('order/_status.html.twig') }}</td>
                    <td>{% if order.paid %}<span class="tag tag--ok">Payée</span>{% else %}<span class="tag">Non payée</span>{% endif %}</td>
                    <td class="num">{{ order.total|eur }}</td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
    {% else %}
    <div class="empty">
        {{ icon('clipboard-list') }}
        <h2>Aucune commande{{ current_status ? ' dans cet état' }}</h2>
        <p>Les commandes des clients apparaîtront ici.</p>
    </div>
    {% endif %}
</section>
{% endblock %}
