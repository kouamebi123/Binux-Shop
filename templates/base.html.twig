<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}Binux Shop{% endblock %}</title>
    <meta name="description" content="{% block description %}Binux Shop, la boutique en ligne de démonstration signée BinuxLabs : catalogue, panier, commande et paiement Stripe.{% endblock %}">
    <meta name="theme-color" content="#0B1026">
    <meta name="color-scheme" content="light">
    <meta property="og:site_name" content="Binux Shop">
    <meta property="og:title" content="{{ block('title') }}">
    <meta property="og:description" content="{{ block('description') }}">
    <meta property="og:type" content="website">
    <link rel="icon" href="{{ asset('assets/favicon.svg') }}" type="image/svg+xml">
    <link rel="preload" href="{{ asset('assets/fonts/hanken-grotesk-latin-wght-normal.woff2') }}" as="font" type="font/woff2" crossorigin>
    <link rel="preload" href="{{ asset('assets/fonts/unbounded-latin-wght-normal.woff2') }}" as="font" type="font/woff2" crossorigin>
    <link rel="stylesheet" href="{{ asset('assets/css/app.css') }}">
    {% block stylesheets %}{% endblock %}
    <script src="{{ asset('assets/js/app.js') }}" defer></script>
    {% block javascripts %}{% endblock %}
</head>
<body class="{% block body_class %}{% endblock %}">
{% block shell %}
    <a class="skip-link" href="#contenu">Aller au contenu</a>

    {% if shop.demo %}
        <p class="demo-strip">
            Boutique de démonstration&nbsp;: rien n'est vendu ni livré, le paiement est en mode test.
            <a href="{{ path('app_about') }}">En savoir plus</a>
        </p>
    {% endif %}

    <header class="site-header{% block header_class %}{% endblock %}" data-header>
        <div class="wrap site-header__bar">
            <a class="brand" href="{{ path('app_home') }}" aria-label="Binux Shop, accueil">
                <span class="brand__a">Binux</span><span class="brand__b">Shop</span>
            </a>

            <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="menu" data-nav-toggle>
                {{ icon('menu') }}<span class="sr-only">Menu</span>
            </button>

            <nav class="site-nav" id="menu" aria-label="Navigation principale" data-nav>
                <a class="site-nav__link" href="{{ path('app_product_index') }}">Tous les articles</a>

                <details class="menu" data-menu>
                    <summary class="site-nav__link">Rayons {{ icon('chevron-down', 'icon--sm') }}</summary>
                    <ul class="menu__panel">
                        {% for row in shop.categories %}
                            <li>
                                <a href="{{ path('app_product_category', {slug: row.category.slug}) }}">
                                    <span>{{ row.category.name }}</span>
                                    <span class="menu__count">{{ row.count }}</span>
                                </a>
                            </li>
                        {% endfor %}
                    </ul>
                </details>

                <form class="search" action="{{ path('app_product_search') }}" method="get" role="search" data-search data-suggest-url="{{ path('app_product_suggest') }}">
                    <label class="sr-only" for="recherche">Rechercher un article</label>
                    {{ icon('search') }}
                    <input id="recherche" type="search" name="q" placeholder="Rechercher un article" autocomplete="off" maxlength="80"
                           value="{{ app.request.query.get('q')|default('') }}" aria-controls="suggestions" aria-autocomplete="list">
                    <ul class="search__results" id="suggestions" role="listbox" hidden data-search-results></ul>
                </form>
            </nav>

            <div class="site-header__actions">
                {% if is_granted('IS_AUTHENTICATED_FULLY') %}
                    <details class="menu menu--end" data-menu>
                        <summary class="icon-link" aria-label="Mon compte, {{ app.user.firstName }}">
                            {{ icon('user') }}<span class="icon-link__text">{{ app.user.firstName }}</span>
                        </summary>
                        <ul class="menu__panel">
                            <li><a href="{{ path('app_account') }}">Mon compte</a></li>
                            <li><a href="{{ path('app_order_list') }}">Mes commandes</a></li>
                            {% if is_granted('ROLE_ADMIN') %}
                                <li class="menu__sep"><a href="{{ path('app_admin_dashboard') }}">Administration</a></li>
                            {% endif %}
                            <li class="menu__sep"><a href="{{ logout_path('main') }}">Déconnexion</a></li>
                        </ul>
                    </details>
                    <a class="icon-link icon-link--cart" href="{{ path('app_cart_index') }}" aria-label="Panier">
                        {{ icon('shopping-bag') }}
                        <span class="cart-count{% if shop.cartCount == 0 %} is-empty{% endif %}" data-cart-count>{{ shop.cartCount }}</span>
                    </a>
                {% else %}
                    <a class="site-nav__link site-nav__link--plain" href="{{ path('app_login') }}">Connexion</a>
                    <a class="btn btn--sm btn--header" href="{{ path('app_register') }}">Créer un compte</a>
                {% endif %}
            </div>
        </div>
    </header>

    <main id="contenu" tabindex="-1">
        {{ include('_flashes.html.twig') }}

        {% block body %}{% endblock %}
    </main>

    <footer class="site-footer">
        <div class="wrap site-footer__grid">
            <div class="site-footer__brand">
                <p class="brand brand--footer"><span class="brand__a">Binux</span><span class="brand__b">Shop</span></p>
                <p>Une boutique en ligne complète, du rayon au paiement, conçue comme vitrine du savoir-faire de BinuxLabs.</p>
            </div>
            <nav aria-label="Boutique">
                <h2>Boutique</h2>
                <ul>
                    <li><a href="{{ path('app_product_index') }}">Tous les articles</a></li>
                    {% for row in shop.categories %}
                        <li><a href="{{ path('app_product_category', {slug: row.category.slug}) }}">{{ row.category.name }}</a></li>
                    {% endfor %}
                </ul>
            </nav>
            <nav aria-label="Votre compte">
                <h2>Votre compte</h2>
                <ul>
                    {% if is_granted('IS_AUTHENTICATED_FULLY') %}
                        <li><a href="{{ path('app_account') }}">Mon compte</a></li>
                        <li><a href="{{ path('app_order_list') }}">Mes commandes</a></li>
                        <li><a href="{{ path('app_cart_index') }}">Panier</a></li>
                    {% else %}
                        <li><a href="{{ path('app_login') }}">Connexion</a></li>
                        <li><a href="{{ path('app_register') }}">Créer un compte</a></li>
                    {% endif %}
                </ul>
            </nav>
            <nav aria-label="À propos">
                <h2>À propos</h2>
                <ul>
                    <li><a href="{{ path('app_about') }}">Cette boutique</a></li>
                    <li><a href="{{ path('app_about') }}#donnees">Vos données</a></li>
                    <li><a href="{{ shop.brandUrl }}/contact" rel="noopener">Contacter BinuxLabs</a></li>
                </ul>
            </nav>
        </div>
        <div class="wrap site-footer__legal">
            <div>
                <p>&copy; {{ 'now'|date('Y') }} Binux Shop</p>
                <p class="signature">Signé <a href="{{ shop.brandUrl }}" rel="noopener">BinuxLabs</a></p>
            </div>
        </div>
    </footer>

    <div class="cart-toast" role="status" aria-live="polite" hidden data-cart-toast>
        <div class="cart-toast__head">
            {{ icon('circle-check') }}<p data-cart-toast-title>Ajouté au panier</p>
            <button type="button" class="flash__close" aria-label="Fermer" data-cart-toast-close>{{ icon('x', 'icon--sm') }}</button>
        </div>
        <div class="cart-toast__item">
            <span class="thumb" data-cart-toast-thumb></span>
            <div>
                <p class="cart-toast__name" data-cart-toast-name></p>
                <p class="cart-toast__price" data-cart-toast-price></p>
            </div>
        </div>
        <p class="cart-toast__total">Total du panier <strong data-cart-toast-total></strong></p>
        <div class="cart-toast__actions">
            <a class="btn btn--sm" href="{{ path('app_cart_index') }}">Voir le panier</a>
            <button type="button" class="btn btn--sm btn--quiet" data-cart-toast-close>Continuer mes achats</button>
        </div>
    </div>
{% endblock %}
</body>
</html>
