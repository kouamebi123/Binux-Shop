{% extends 'account/_layout.html.twig' %}

{% block title %}Mot de passe · Binux Shop{% endblock %}
{% block account_title %}Mot de passe{% endblock %}
{% set account_section = 'password' %}

{% block account_body %}
    <section class="panel">
        {{ form_start(form) }}
        {{ form_errors(form) }}
        {{ form_row(form.currentPassword) }}
        {{ form_row(form.newPassword.first) }}
        {{ form_row(form.newPassword.second) }}
        <div class="form-actions">
            <button type="submit" class="btn">Changer le mot de passe</button>
        </div>
        {{ form_end(form) }}
    </section>
{% endblock %}
