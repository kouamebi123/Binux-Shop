{% extends 'base.html.twig' %}

{% block title %}Créer une commande - Binux Shop{% endblock %}

{% block body %}
<div class="bg-light py-5">
    <div class="container">
        <h1 class="fw-bold">Finaliser ma commande</h1>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="{{ path('app_home') }}">Accueil</a></li>
                <li class="breadcrumb-item"><a href="{{ path('app_cart_index') }}">Panier</a></li>
                <li class="breadcrumb-item active">Commande</li>
            </ol>
        </nav>
    </div>
</div>

<div class="container my-5">
    <div class="row">
        <div class="col-lg-8 mb-4">
            <div class="card mb-4">
                <div class="card-body">
                    <h5 class="card-title fw-bold mb-4">
                        <i class="bi bi-geo-alt"></i> Adresse de livraison
                    </h5>
                    
                    {{ form_start(form) }}
                    
                    <div class="mb-3">
                        {{ form_row(form.address.street) }}
                    </div>
                    
                    <div class="mb-3">
                        {{ form_row(form.address.complement) }}
                    </div>
                    
                    <div class="row">
                        <div class="col-md-8 mb-3">
                            {{ form_row(form.address.city) }}
                        </div>
                        <div class="col-md-4 mb-3">
                            {{ form_row(form.address.postalCode) }}
                        </div>
                    </div>
                    
                    <div class="mb-3">
                        {{ form_row(form.address.country) }}
                    </div>
                    
                    <div class="mb-3">
                        <div class="form-check">
                            {{ form_widget(form.address.isDefault) }}
                            {{ form_label(form.address.isDefault) }}
                        </div>
                    </div>
                </div>
            </div>

            <div class="card">
                <div class="card-body">
                    <h5 class="card-title fw-bold mb-4">
                        <i class="bi bi-chat-left-text"></i> Notes de commande
                    </h5>
                    
                    {{ form_row(form.notes) }}
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card mb-3">
                <div class="card-body">
                    <h5 class="card-title fw-bold mb-4">Récapitulatif</h5>
                    
                    {% for item in cart.items %}
                    <div class="d-flex justify-content-between mb-2">
                        <span class="small">{{ item.product.name }} x {{ item.quantity }}</span>
                        <span class="small fw-bold">{{ item.total }} €</span>
                    </div>
                    {% endfor %}
                    
                    <hr>
                    
                    <div class="d-flex justify-content-between mb-2">
                        <span>Sous-total</span>
                        <span class="fw-bold">{{ cart.total }} €</span>
                    </div>
                    
                    <div class="d-flex justify-content-between mb-3">
                        <span>Livraison</span>
                        <span class="text-success fw-bold">Gratuite</span>
                    </div>
                    
                    <hr>
                    
                    <div class="d-flex justify-content-between mb-4">
                        <span class="h5 mb-0">Total</span>
                        <span class="h5 mb-0 text-primary">{{ cart.total }} €</span>
                    </div>
                    
                    <button type="submit" class="btn btn-primary w-100 btn-lg">
                        <i class="bi bi-check-circle"></i> Valider la commande
                    </button>
                    
                    {{ form_end(form) }}
                </div>
            </div>

            <div class="card">
                <div class="card-body">
                    <h6 class="fw-bold mb-3">
                        <i class="bi bi-truck text-primary"></i> Livraison gratuite
                    </h6>
                    <p class="small text-muted mb-3">Livraison sous 3-5 jours ouvrés</p>
                    
                    <h6 class="fw-bold mb-3">
                        <i class="bi bi-shield-check text-success"></i> Paiement sécurisé
                    </h6>
                    <p class="small text-muted mb-0">Vos données sont protégées</p>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}

