{% extends 'admin/_layout.html.twig' %}

{% block title %}Commande {{ order.orderNumber }} · Administration{% endblock %}
{% block admin_title %}Commande <span class="order-number">{{ order.orderNumber }}</span>{% endblock %}
{% block admin_intro %}<p>Passée le {{ order.createdAt|date('d/m/Y à H:i') }}{% if order.updatedAt %}, mise à jour le {{ order.updatedAt|date('d/m/Y à H:i') }}{% endif %}.</p>{% endblock %}
{% block admin_actions %}<a href="{{ path('app_admin_orders') }}" class="btn btn--sm btn--quiet">Retour aux commandes</a>{% endblock %}
{% set admin_section = 'orders' %}

{% block admin_body %}
<div class="admin__cols admin__cols--form">
    <div>
        <section class="panel" aria-labelledby="articles">
            <h2 id="articles">Articles</h2>
            {{ include('order/_summary.html.twig') }}
            <dl class="totals totals--after-lines">
                <div><dt>Livraison</dt><dd>Offerte</dd></div>
                <div class="totals__grand"><dt>Total</dt><dd>{{ order.total|eur }}</dd></div>
            </dl>
        </section>

        <section class="panel" aria-labelledby="client">
            <h2 id="client">Client et livraison</h2>
            <dl class="kv">
                <div><dt>Client</dt><dd>{{ order.user.fullName }}</dd></div>
                <div><dt>E-mail</dt><dd>{{ order.user.email }}</dd></div>
                {% if order.user.phone %}<div><dt>Téléphone</dt><dd>{{ order.user.phone }}</dd></div>{% endif %}
                <div><dt>Adresse de livraison</dt><dd>{{ order.shippingAddress }}</dd></div>
                {% if order.notes %}<div><dt>Notes du client</dt><dd>{{ order.notes }}</dd></div>{% endif %}
            </dl>
        </section>
    </div>

    <div>
        <section class="panel" aria-labelledby="etat">
            <h2 id="etat">État</h2>
            <p class="state-line">{{ include('order/_status.html.twig') }}</p>

            {% if order.paid %}
                <p class="note">{{ icon('circle-check') }}<span>Paiement de {{ order.payment.amount|eur }} reçu le {{ order.payment.paidAt|date('d/m/Y à H:i') }}.</span></p>
            {% elseif not order.cancelled %}
                <p class="note note--warn">{{ icon('triangle-alert') }}<span>Paiement non reçu. Cette commande ne peut pas être préparée tant qu'elle n'est pas payée.</span></p>
            {% endif %}

            {% if allowed_statuses|length > 0 %}
            <form method="post" action="{{ path('app_admin_order_status', {id: order.id}) }}" class="state-form">
                <input type="hidden" name="_token" value="{{ csrf_token('update_order_status_' ~ order.id) }}">
                <div class="field">
                    <label class="field__label" for="status">Changer le statut</label>
                    <select name="status" id="status" class="form-select" required>
                        {% for key in allowed_statuses %}
                            <option value="{{ key }}">{{ available_statuses[key] }}</option>
                        {% endfor %}
                    </select>
                    <p class="field__help">Annuler remet les articles en stock.{% if order.paid %} Le remboursement se fait depuis le tableau de bord Stripe.{% endif %}</p>
                </div>
                <button type="submit" class="btn btn--block">Mettre à jour</button>
            </form>
            {% else %}
                <p class="muted">Cette commande est terminée&nbsp;: son statut ne change plus.</p>
            {% endif %}
        </section>
    </div>
</div>
{% endblock %}
