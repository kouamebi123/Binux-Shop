{% extends 'base.html.twig' %}

{% block title %}{{ category.name }} · Binux Shop{% endblock %}
{% block description %}{{ category.description ?: category.name }}{% endblock %}

{% block body %}
<div class="wrap">
    <header class="page-head">
        <ol class="crumbs">
            <li><a href="{{ path('app_home') }}">Accueil</a></li>
            <li><a href="{{ path('app_product_index') }}">Articles</a></li>
            <li aria-current="page">{{ category.name }}</li>
        </ol>
        <h1>{{ category.name }}</h1>
        {% if category.description %}<p>{{ category.description }}</p>{% endif %}
    </header>
    {{ include('product/_listing.html.twig', {route: 'app_product_category', route_params: {slug: category.slug}}) }}
</div>
<div class="section"></div>
{% endblock %}
