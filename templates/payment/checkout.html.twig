{% extends 'base.html.twig' %}

{% block title %}Paiement - Binux Shop{% endblock %}

{% block body %}
<div class="bg-light py-5">
    <div class="container">
        <h1 class="fw-bold">Paiement sécurisé</h1>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="{{ path('app_home') }}">Accueil</a></li>
                <li class="breadcrumb-item"><a href="{{ path('app_cart_index') }}">Panier</a></li>
                <li class="breadcrumb-item"><a href="{{ path('app_order_create') }}">Commande</a></li>
                <li class="breadcrumb-item active">Paiement</li>
            </ol>
        </nav>
    </div>
</div>

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-lg">
                <div class="card-body p-5">
                    <div class="text-center mb-5">
                        <i class="bi bi-credit-card text-primary" style="font-size: 4rem;"></i>
                        <h2 class="mt-3 fw-bold">Paiement sécurisé avec Stripe</h2>
                        <p class="text-muted">Vos informations de paiement sont protégées et cryptées</p>
                    </div>

                    <div class="alert alert-info mb-4">
                        <i class="bi bi-info-circle"></i> 
                        <strong>Commande : {{ order.orderNumber }}</strong><br>
                        Montant à payer : <strong>{{ order.total }} €</strong>
                    </div>

                    <div class="card mb-4">
                        <div class="card-body">
                            <h5 class="fw-bold mb-3">Récapitulatif</h5>
                            {% for item in order.items %}
                            <div class="d-flex justify-content-between mb-2">
                                <span>{{ item.productName }} x {{ item.quantity }}</span>
                                <span class="fw-bold">{{ item.total }} €</span>
                            </div>
                            {% endfor %}
                            <hr>
                            <div class="d-flex justify-content-between">
                                <span class="h5">Total</span>
                                <span class="h5 text-primary">{{ order.total }} €</span>
                            </div>
                        </div>
                    </div>

                    <div class="d-grid mb-3">
                        <button id="checkout-button" class="btn btn-primary btn-lg">
                            <i class="bi bi-lock-fill"></i> Procéder au paiement
                        </button>
                    </div>

                    <div class="text-center">
                        <p class="small text-muted mb-0">
                            <i class="bi bi-shield-check"></i> Paiement 100% sécurisé par Stripe
                        </p>
                    </div>
                </div>
            </div>

            <div class="text-center mt-4">
                <img src="https://stripe.com/img/v3/newsroom/social.png" alt="Powered by Stripe" style="max-width: 150px; opacity: 0.7;">
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
<script src="https://js.stripe.com/v3/"></script>
<script>
    var stripe = Stripe('{{ stripe_public_key }}');
    var checkoutButton = document.getElementById('checkout-button');

    checkoutButton.addEventListener('click', function() {
        checkoutButton.disabled = true;
        checkoutButton.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Redirection vers Stripe...';
        
        stripe.redirectToCheckout({
            sessionId: '{{ checkout_session_id }}'
        }).then(function(result) {
            if (result.error) {
                alert(result.error.message);
                checkoutButton.disabled = false;
                checkoutButton.innerHTML = '<i class="bi bi-lock-fill"></i> Procéder au paiement';
            }
        });
    });
</script>
{% endblock %}

