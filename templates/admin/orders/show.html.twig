{% extends 'base.html.twig' %}

{% block title %}Commande {{ order.orderNumber }} - Admin{% endblock %}

{% block body %}
<div class="bg-dark text-white py-4">
    <div class="container">
        <h1 class="fw-bold">Commande {{ order.orderNumber }}</h1>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb bg-transparent text-white-50 mb-0">
                <li class="breadcrumb-item"><a href="{{ path('app_admin_dashboard') }}" class="text-white-50">Admin</a></li>
                <li class="breadcrumb-item"><a href="{{ path('app_admin_orders') }}" class="text-white-50">Commandes</a></li>
                <li class="breadcrumb-item active text-white">{{ order.orderNumber }}</li>
            </ol>
        </nav>
    </div>
</div>

<div class="container my-5">
    <div class="row">
        <div class="col-lg-8 mb-4">
            <div class="card mb-4">
                <div class="card-body">
                    <h5 class="card-title fw-bold mb-4">Informations</h5>
                    
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <p class="text-muted mb-1">Client</p>
                            <p class="fw-bold">{{ order.user.fullName }}</p>
                            <p class="small text-muted">{{ order.user.email }}</p>
                        </div>
                        <div class="col-md-6">
                            <p class="text-muted mb-1">Date de commande</p>
                            <p class="fw-bold">{{ order.createdAt|date('d/m/Y à H:i') }}</p>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card mb-4">
                <div class="card-body">
                    <h5 class="card-title fw-bold mb-4">Articles</h5>
                    
                    {% for item in order.items %}
                    <div class="row align-items-center mb-3 pb-3 {% if not loop.last %}border-bottom{% endif %}">
                        <div class="col-md-6">
                            <h6 class="mb-1">{{ item.productName }}</h6>
                            <p class="text-muted small mb-0">Prix unitaire : {{ item.price }} €</p>
                        </div>
                        <div class="col-md-3">
                            <p class="mb-0">Quantité : {{ item.quantity }}</p>
                        </div>
                        <div class="col-md-3 text-end">
                            <p class="mb-0 fw-bold text-primary">{{ item.total }} €</p>
                        </div>
                    </div>
                    {% endfor %}
                </div>
            </div>

            <div class="card">
                <div class="card-body">
                    <h5 class="card-title fw-bold mb-3">Adresse de livraison</h5>
                    <p class="mb-0">{{ order.shippingAddress|nl2br }}</p>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card mb-4">
                <div class="card-body">
                    <h5 class="card-title fw-bold mb-4">Statut du paiement</h5>
                    {% if order.isPaid %}
                        <div class="alert alert-success">
                            <i class="bi bi-check-circle-fill"></i> <strong>Payée</strong><br>
                            <small>Le {{ order.payment.paidAt|date('d/m/Y à H:i') }}</small>
                        </div>
                    {% else %}
                        <div class="alert alert-warning">
                            <i class="bi bi-exclamation-triangle-fill"></i> <strong>Non payée</strong><br>
                            <small>En attente de paiement</small>
                        </div>
                    {% endif %}
                </div>
            </div>

            <div class="card mb-4">
                <div class="card-body">
                    <h5 class="card-title fw-bold mb-4">Statut de la commande</h5>
                    
                    {% if not order.isPaid %}
                        <div class="alert alert-danger mb-3">
                            <i class="bi bi-lock-fill"></i> 
                            <strong>Attention :</strong> Cette commande ne peut pas être traitée car elle n'a pas été payée.
                        </div>
                    {% endif %}
                    
                    <form method="post" action="{{ path('app_admin_order_status', {id: order.id}) }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('update_order_status_' ~ order.id) }}">
                        <div class="mb-3">
                            <select name="status" class="form-select" {{ not order.isPaid and order.status == 'pending' ? 'disabled' : '' }}>
                                {% for statusKey, statusLabel in available_statuses %}
                                    {% set isRestricted = statusKey in ['processing', 'shipped', 'delivered'] and not order.isPaid %}
                                    <option value="{{ statusKey }}" 
                                            {{ order.status == statusKey ? 'selected' : '' }}
                                            {{ isRestricted ? 'disabled' : '' }}>
                                        {{ statusLabel }}
                                        {{ isRestricted ? ' (Paiement requis)' : '' }}
                                    </option>
                                {% endfor %}
                            </select>
                        </div>
                        <button type="submit" 
                                class="btn btn-primary w-100" 
                                {{ not order.isPaid and order.status == 'pending' ? 'disabled' : '' }}>
                            <i class="bi bi-save"></i> Mettre à jour
                        </button>
                        {% if not order.isPaid and order.status == 'pending' %}
                            <small class="text-muted d-block mt-2">
                                <i class="bi bi-info-circle"></i> Disponible après paiement
                            </small>
                        {% endif %}
                    </form>
                </div>
            </div>

            <div class="card">
                <div class="card-body">
                    <h5 class="card-title fw-bold mb-4">Récapitulatif</h5>
                    
                    {% for item in order.items %}
                    <div class="d-flex justify-content-between mb-2">
                        <span class="small">{{ item.productName }} x {{ item.quantity }}</span>
                        <span class="small fw-bold">{{ item.total }} €</span>
                    </div>
                    {% endfor %}
                    
                    <hr>
                    
                    <div class="d-flex justify-content-between mb-4">
                        <span class="h5 mb-0">Total</span>
                        <span class="h5 mb-0 text-primary">{{ order.total }} €</span>
                    </div>
                    
                    <a href="{{ path('app_admin_orders') }}" class="btn btn-outline-secondary w-100">
                        <i class="bi bi-arrow-left"></i> Retour
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}

