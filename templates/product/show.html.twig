{% extends 'base.html.twig' %}

{% block title %}{{ product.name }} · Binux Shop{% endblock %}
{% block description %}{{ product.description ? (product.description|length > 155 ? product.description|slice(0, 152) ~ '…' : product.description) : product.name }}{% endblock %}

{% block body %}
<div class="wrap">
    <div class="page-head">
        <ol class="crumbs">
            <li><a href="{{ path('app_home') }}">Accueil</a></li>
            <li><a href="{{ path('app_product_index') }}">Articles</a></li>
            <li><a href="{{ path('app_product_category', {slug: product.category.slug}) }}">{{ product.category.name }}</a></li>
            <li aria-current="page">{{ product.name }}</li>
        </ol>
    </div>

    <article class="product">
        <div class="product__media thumb">
            <span class="thumb__mono">{{ product.name|first|upper }}</span>
            {% if product.imageUrl %}
                <img src="{{ product.imageUrl }}" alt="{{ product.name }}" width="900" height="1080" fetchpriority="high" data-img>
            {% endif %}
        </div>

        <div class="product__info">
            <div class="product__tags">
                <a class="tag" href="{{ path('app_product_category', {slug: product.category.slug}) }}">{{ product.category.name }}</a>
                {% if product.hasDiscount %}<span class="tag tag--sale">−{{ product.discountPercentage }}&nbsp;%</span>{% endif %}
            </div>

            <h1>{{ product.name }}</h1>

            <p class="price price--lg">
                <span class="price__now">{{ product.price|eur }}</span>
                {% if product.hasDiscount %}
                    <s class="price__old"><span class="sr-only">Ancien prix&nbsp;: </span>{{ product.oldPrice|eur }}</s>
                {% endif %}
            </p>

            {% if product.description %}
                <p class="product__desc">{{ product.description }}</p>
            {% endif %}

            <div class="buy">
                {% if not product.inStock %}
                    <p class="stock stock--out">Épuisé pour le moment</p>
                {% elseif product.lowStock %}
                    <p class="stock stock--low">Plus que {{ product.stock }} en stock</p>
                {% else %}
                    <p class="stock">En stock, {{ product.stock }} disponibles</p>
                {% endif %}

                {% if product.inStock %}
                    {% if is_granted('IS_AUTHENTICATED_FULLY') %}
                        <form class="buy__row" method="post" action="{{ path('app_cart_add', {id: product.id}) }}" data-cart-add>
                            <input type="hidden" name="_token" value="{{ csrf_token('cart_add_' ~ product.id) }}">
                            <div class="stepper">
                                <button type="button" data-step="-1" aria-label="Diminuer la quantité">{{ icon('minus', 'icon--sm') }}</button>
                                <label class="sr-only" for="quantity">Quantité</label>
                                <input type="number" id="quantity" name="quantity" value="1" min="1" max="{{ min(product.stock, max_quantity) }}" inputmode="numeric">
                                <button type="button" data-step="1" aria-label="Augmenter la quantité">{{ icon('plus', 'icon--sm') }}</button>
                            </div>
                            <button type="submit" class="btn">{{ icon('shopping-bag') }} Ajouter au panier</button>
                        </form>
                    {% else %}
                        <a class="btn btn--block" href="{{ path('app_login', {retour: path('app_product_show', {slug: product.slug})}) }}">Se connecter pour commander</a>
                        <p class="fine">Pas encore de compte&nbsp;? <a href="{{ path('app_register') }}">Créez-le en une minute</a>.</p>
                    {% endif %}
                {% endif %}
            </div>

            <ul class="facts">
                <li>{{ icon('truck') }} <span>Livraison offerte, sans minimum d'achat.</span></li>
                <li>{{ icon('lock') }} <span>Paiement par carte sur la page sécurisée de Stripe.</span></li>
                <li>{{ icon('rotate-ccw') }} <span>Commande annulable en un clic tant qu'elle n'est pas payée.</span></li>
            </ul>
        </div>
    </article>
</div>

{% if related_products|length > 0 %}
<section class="section section--tint" aria-labelledby="meme-rayon">
    <div class="wrap">
        <div class="section__head">
            <h2 id="meme-rayon">Dans le même rayon</h2>
            <a class="link-more" href="{{ path('app_product_category', {slug: product.category.slug}) }}">Tout le rayon {{ product.category.name }}</a>
        </div>
        <div class="grid-products">
            {% for relatedProduct in related_products %}
                {{ include('product/_card.html.twig', {product: relatedProduct}) }}
            {% endfor %}
        </div>
    </div>
</section>
{% endif %}
{% endblock %}
