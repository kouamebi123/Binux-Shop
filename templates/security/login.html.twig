{% extends 'security/_layout.html.twig' %}

{% block title %}Connexion · Binux Shop{% endblock %}

{% block auth_body %}
    <h1>Connexion</h1>
    <p>Heureux de vous revoir.</p>

    {% if error %}
        <ul class="field__errors field__errors--global" role="alert">
            <li>{{ error.messageKey|trans(error.messageData, 'security') }}</li>
        </ul>
    {% endif %}

    <form method="post" action="{{ path('app_login') }}">
        <div class="field">
            <label class="field__label" for="username">Adresse e-mail</label>
            <input type="email" class="form-control" id="username" name="_username" value="{{ last_username }}" required autofocus autocomplete="email">
        </div>
        <div class="field">
            <label class="field__label" for="password">Mot de passe</label>
            <input type="password" class="form-control" id="password" name="_password" required autocomplete="current-password">
        </div>
        <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
        {% if target_path %}<input type="hidden" name="_target_path" value="{{ target_path }}">{% endif %}
        <button type="submit" class="btn btn--block">Se connecter</button>
    </form>

    <p class="auth__alt">Pas encore de compte&nbsp;? <a href="{{ path('app_register') }}">Créer un compte</a></p>
{% endblock %}
