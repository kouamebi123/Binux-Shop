# This file defines default values for environment variables
# Real secrets should be set in .env.local (not committed) or via Railway environment variables

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=
###< symfony/framework-bundle ###

###> doctrine/doctrine-bundle ###
# Base locale de développement : celle du fichier docker-compose.yml (docker compose up -d database).
DATABASE_URL="postgresql://app:!ChangeMe!@127.0.0.1:5432/app?serverVersion=16&charset=utf8"
###< doctrine/doctrine-bundle ###

###> symfony/messenger ###
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
###< symfony/messenger ###

###> symfony/mailer ###
# MAILER_DSN=null://null
###< symfony/mailer ###

###> Stripe Configuration ###
# À définir dans les variables Railway (jamais dans le dépôt).
STRIPE_SECRET_KEY=
# Secret de signature du point de notification /stripe/webhook (whsec_...).
STRIPE_WEBHOOK_SECRET=
###< Stripe Configuration ###

###> Binux Shop ###
# Code d'installation du compte administrateur (/installation). Vide = page inexistante.
SETUP_TOKEN=
# Adresses des proxys de confiance. Sur Railway : 127.0.0.1,REMOTE_ADDR
TRUSTED_PROXIES=127.0.0.1
###< Binux Shop ###

###> symfony/lock ###
# Choose one of the stores below
# postgresql+advisory://db_user:db_password@localhost/db_name
LOCK_DSN=flock
###< symfony/lock ###
