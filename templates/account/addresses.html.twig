{% extends 'base.html.twig' %}

{% block title %}Mes adresses - Binux Shop{% endblock %}

{% block body %}
<div class="bg-light py-5">
    <div class="container">
        <h1 class="fw-bold">Mes adresses</h1>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="{{ path('app_home') }}">Accueil</a></li>
                <li class="breadcrumb-item"><a href="{{ path('app_account') }}">Mon compte</a></li>
                <li class="breadcrumb-item active">Adresses</li>
            </ol>
        </nav>
    </div>
</div>

<div class="container my-5">
    <div class="mb-4">
        <a href="{{ path('app_account_address_add') }}" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i> Ajouter une adresse
        </a>
    </div>

    {% if app.user.addresses|length > 0 %}
    <div class="row g-4">
        {% for address in app.user.addresses %}
        <div class="col-md-6 col-lg-4">
            <div class="card h-100">
                <div class="card-body">
                    {% if address.isIsDefault %}
                        <span class="badge bg-primary mb-2">Adresse par défaut</span>
                    {% endif %}
                    <p class="mb-1"><strong>{{ address.street }}</strong></p>
                    {% if address.complement %}
                        <p class="mb-1">{{ address.complement }}</p>
                    {% endif %}
                    <p class="mb-1">{{ address.postalCode }} {{ address.city }}</p>
                    <p class="mb-3">{{ address.country }}</p>
                    
                    <div class="d-flex gap-2">
                        <a href="{{ path('app_account_address_edit', {id: address.id}) }}" class="btn btn-sm btn-outline-primary">
                            <i class="bi bi-pencil"></i> Modifier
                        </a>
                        <form method="post" action="{{ path('app_account_address_delete', {id: address.id}) }}" class="d-inline">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete_address_' ~ address.id) }}">
                            <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('Êtes-vous sûr de vouloir supprimer cette adresse ?')">
                                <i class="bi bi-trash"></i> Supprimer
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
        {% endfor %}
    </div>
    {% else %}
    <div class="text-center py-5">
        <i class="bi bi-geo-alt" style="font-size: 5rem; color: #ccc;"></i>
        <h3 class="mt-4">Aucune adresse enregistrée</h3>
        <p class="text-muted mb-4">Ajoutez une adresse pour faciliter vos commandes</p>
        <a href="{{ path('app_account_address_add') }}" class="btn btn-primary btn-lg">
            <i class="bi bi-plus-circle"></i> Ajouter une adresse
        </a>
    </div>
    {% endif %}
</div>
{% endblock %}

