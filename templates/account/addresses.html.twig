{% extends 'account/_layout.html.twig' %}

{% block title %}Mes adresses · Binux Shop{% endblock %}
{% block account_title %}Mes adresses{% endblock %}
{% set account_section = 'addresses' %}

{% block account_body %}
    <div class="stack">
        {% if app.user.addresses|length > 0 %}
        <ul class="rows">
            {% for address in app.user.addresses %}
            <li class="row-card">
                <div class="row-card__main">
                    <strong>{{ address.street }}{% if address.complement %}, {{ address.complement }}{% endif %}</strong>
                    <span class="row-card__meta">{{ address.postalCode }} {{ address.city }}, {{ address.country }}</span>
                </div>
                <div class="row-card__end">
                    {% if address.isDefault %}<span class="tag tag--info">Par défaut</span>{% endif %}
                    <a href="{{ path('app_account_address_edit', {id: address.id}) }}">Modifier</a>
                    <form method="post" action="{{ path('app_account_address_delete', {id: address.id}) }}" data-confirm="Supprimer cette adresse ?">
                        <input type="hidden" name="_token" value="{{ csrf_token('delete_address_' ~ address.id) }}">
                        <button type="submit" class="link-button">Supprimer</button>
                    </form>
                </div>
            </li>
            {% endfor %}
        </ul>
        {% else %}
        <div class="empty">
            {{ icon('map-pin') }}
            <h2>Aucune adresse enregistrée</h2>
            <p>Ajoutez-en une pour gagner du temps à la prochaine commande.</p>
        </div>
        {% endif %}
        <div><a href="{{ path('app_account_address_add') }}" class="btn">{{ icon('plus') }} Ajouter une adresse</a></div>
    </div>
{% endblock %}
