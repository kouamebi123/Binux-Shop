{% extends 'base.html.twig' %}

{% block title %}{{ query ? 'Recherche : ' ~ query : 'Recherche' }} · Binux Shop{% endblock %}

{% block body %}
<div class="wrap">
    <header class="page-head">
        <h1>{% if query %}Résultats pour «&nbsp;{{ query }}&nbsp;»{% else %}Rechercher un article{% endif %}</h1>
        {% if not query %}<p>Saisissez un nom d'article ou de rayon dans la barre de recherche.</p>{% endif %}
    </header>
    {{ include('product/_listing.html.twig', {route: 'app_product_search', route_params: {}}) }}
</div>
<div class="section"></div>
{% endblock %}
