{% extends 'account/_layout.html.twig' %}

{% block title %}Mon profil · Binux Shop{% endblock %}
{% block account_title %}Mon profil{% endblock %}
{% set account_section = 'profile' %}

{% block account_body %}
    <section class="panel">
        {{ form_start(form) }}
        {{ form_errors(form) }}
        <div class="form-grid">
            {{ form_row(form.firstName, {attr: {autocomplete: 'given-name'}}) }}
            {{ form_row(form.lastName, {attr: {autocomplete: 'family-name'}}) }}
            {{ form_row(form.email, {row_attr: {class: 'field--wide'}, attr: {autocomplete: 'email'}, help: 'C\'est aussi votre identifiant de connexion.'}) }}
            {{ form_row(form.phone, {row_attr: {class: 'field--wide'}, attr: {autocomplete: 'tel'}}) }}
        </div>
        <div class="form-actions">
            <button type="submit" class="btn">Enregistrer</button>
        </div>
        {{ form_end(form) }}
    </section>
{% endblock %}
