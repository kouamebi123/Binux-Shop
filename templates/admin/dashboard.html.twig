{% extends 'base.html.twig' %}

{% block title %}Administration - Binux Shop{% endblock %}

{% block body %}
<div class="bg-dark text-white py-4">
    <div class="container">
        <h1 class="fw-bold"><i class="bi bi-speedometer2"></i> Administration</h1>
        <p class="mb-0">Tableau de bord</p>
    </div>
</div>

<div class="container my-5">
    <div class="row g-4 mb-5">
        <div class="col-md-4">
            <div class="card text-center">
                <div class="card-body">
                    <i class="bi bi-box-seam text-primary" style="font-size: 3rem;"></i>
                    <h3 class="mt-3 fw-bold">{{ total_products }}</h3>
                    <p class="text-muted mb-0">Produits</p>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card text-center">
                <div class="card-body">
                    <i class="bi bi-bag text-success" style="font-size: 3rem;"></i>
                    <h3 class="mt-3 fw-bold">{{ total_orders }}</h3>
                    <p class="text-muted mb-0">Commandes</p>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card text-center">
                <div class="card-body">
                    <i class="bi bi-people text-warning" style="font-size: 3rem;"></i>
                    <h3 class="mt-3 fw-bold">{{ total_users }}</h3>
                    <p class="text-muted mb-0">Utilisateurs</p>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4 mb-4">
        <div class="col-lg-3 col-md-6">
            <a href="{{ path('app_admin_products') }}" class="text-decoration-none">
                <div class="card h-100 text-center">
                    <div class="card-body">
                        <i class="bi bi-box-seam text-primary" style="font-size: 3rem;"></i>
                        <h5 class="card-title mt-3 fw-bold">Produits</h5>
                        <p class="card-text text-muted">Gérer les produits</p>
                    </div>
                </div>
            </a>
        </div>

        <div class="col-lg-3 col-md-6">
            <a href="{{ path('app_admin_categories') }}" class="text-decoration-none">
                <div class="card h-100 text-center">
                    <div class="card-body">
                        <i class="bi bi-tags text-info" style="font-size: 3rem;"></i>
                        <h5 class="card-title mt-3 fw-bold">Catégories</h5>
                        <p class="card-text text-muted">Gérer les catégories</p>
                    </div>
                </div>
            </a>
        </div>

        <div class="col-lg-3 col-md-6">
            <a href="{{ path('app_admin_orders') }}" class="text-decoration-none">
                <div class="card h-100 text-center">
                    <div class="card-body">
                        <i class="bi bi-bag text-success" style="font-size: 3rem;"></i>
                        <h5 class="card-title mt-3 fw-bold">Commandes</h5>
                        <p class="card-text text-muted">Gérer les commandes</p>
                    </div>
                </div>
            </a>
        </div>

        <div class="col-lg-3 col-md-6">
            <a href="{{ path('app_home') }}" class="text-decoration-none">
                <div class="card h-100 text-center">
                    <div class="card-body">
                        <i class="bi bi-house text-secondary" style="font-size: 3rem;"></i>
                        <h5 class="card-title mt-3 fw-bold">Site</h5>
                        <p class="card-text text-muted">Retour au site</p>
                    </div>
                </div>
            </a>
        </div>
    </div>

    <div class="card">
        <div class="card-header">
            <h5 class="mb-0 fw-bold">Commandes récentes</h5>
        </div>
        <div class="card-body">
            {% if recent_orders|length > 0 %}
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th>Numéro</th>
                            <th>Client</th>
                            <th>Date</th>
                            <th>Total</th>
                            <th>Paiement</th>
                            <th>Statut</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for order in recent_orders %}
                        <tr>
                            <td>{{ order.orderNumber }}</td>
                            <td>{{ order.user.fullName }}</td>
                            <td>{{ order.createdAt|date('d/m/Y H:i') }}</td>
                            <td>{{ order.total }} €</td>
                            <td>
                                {% if order.isPaid %}
                                    <span class="badge bg-success">
                                        <i class="bi bi-check-circle"></i> Payée
                                    </span>
                                {% else %}
                                    <span class="badge bg-danger">
                                        <i class="bi bi-x-circle"></i> Non payée
                                    </span>
                                {% endif %}
                            </td>
                            <td>
                                {% set statusClass = {
                                    'pending': 'warning',
                                    'processing': 'info',
                                    'shipped': 'primary',
                                    'delivered': 'success',
                                    'cancelled': 'danger'
                                } %}
                                <span class="badge bg-{{ statusClass[order.status] ?? 'secondary' }}">
                                    {{ order.statusLabel }}
                                </span>
                            </td>
                            <td>
                                <a href="{{ path('app_admin_order_show', {id: order.id}) }}" class="btn btn-sm btn-outline-primary">
                                    <i class="bi bi-eye"></i> Voir
                                </a>
                            </td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
            {% else %}
            <p class="text-muted text-center mb-0">Aucune commande récente</p>
            {% endif %}
        </div>
    </div>
</div>
{% endblock %}

