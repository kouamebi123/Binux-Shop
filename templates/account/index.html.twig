{% extends 'account/_layout.html.twig' %}

{% block title %}Mon compte · Binux Shop{% endblock %}
{% block account_title %}Bonjour {{ app.user.firstName }}{% endblock %}
{% block account_intro %}<p>{{ app.user.email }}, client depuis le {{ app.user.createdAt|date('d/m/Y') }}.</p>{% endblock %}

{% block account_body %}
    <div class="stack">
        <div class="tiles">
            <a class="tile-link" href="{{ path('app_order_list') }}">{{ icon('receipt') }}<strong>Commandes</strong><span>{{ app.user.orders|length }} passée{{ app.user.orders|length > 1 ? 's' }}</span></a>
            <a class="tile-link" href="{{ path('app_account_addresses') }}">{{ icon('map-pin') }}<strong>Adresses</strong><span>{{ app.user.addresses|length }} enregistrée{{ app.user.addresses|length > 1 ? 's' }}</span></a>
            <a class="tile-link" href="{{ path('app_account_profile') }}">{{ icon('user') }}<strong>Profil</strong><span>Nom, e-mail, téléphone</span></a>
        </div>

        {% if recent_orders|length > 0 %}
        <section aria-labelledby="dernieres">
            <div class="section__head">
                <h2 id="dernieres">Dernières commandes</h2>
                <a class="link-more" href="{{ path('app_order_list') }}">Toutes mes commandes</a>
            </div>
            <ul class="rows">
                {% for order in recent_orders %}
                <li>
                    <a class="row-card" href="{{ path('app_order_show', {id: order.id}) }}">
                        <span class="row-card__main">
                            <span class="order-number">{{ order.orderNumber }}</span>
                            <span class="row-card__meta">{{ order.createdAt|date('d/m/Y') }}</span>
                        </span>
                        <span class="row-card__end">
                            {{ include('order/_status.html.twig') }}
                            <span class="amount">{{ order.total|eur }}</span>
                            {{ icon('chevron-right') }}
                        </span>
                    </a>
                </li>
                {% endfor %}
            </ul>
        </section>
        {% endif %}
    </div>
{% endblock %}
