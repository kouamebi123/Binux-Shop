{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile"
  },
  "deploy": {
    "preDeployCommand": ["php bin/console doctrine:migrations:migrate --no-interaction --allow-no-migration"],
    "startCommand": "sh -c 'php bin/console cache:warmup --no-debug && exec frankenphp run --config /app/Caddyfile --adapter caddyfile'",
    "healthcheckPath": "/sante",
    "healthcheckTimeout": 120,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
