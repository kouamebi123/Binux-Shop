{% extends 'base.html.twig' %}

{% block title %}Commande {{ order.orderNumber }} · Binux Shop{% endblock %}

{% block body %}
<div class="wrap wrap--narrow">
    <div class="confirm">
        {% if order.paid %}
            <span class="confirm__mark">{{ icon('check') }}</span>
            <h1>Merci, votre commande est confirmée</h1>
            <p class="lead">Le paiement de {{ order.total|eur }} est bien reçu. La commande <span class="order-number">{{ order.orderNumber }}</span> part en préparation.</p>
        {% elseif order.cancelled %}
            <span class="confirm__mark confirm__mark--wait">{{ icon('circle-x') }}</span>
            <h1>Cette commande est annulée</h1>
            <p class="lead">La commande <span class="order-number">{{ order.orderNumber }}</span> n'a pas été payée. Rien n'a été débité.</p>
        {% else %}
            <span class="confirm__mark confirm__mark--wait">{{ icon('clock') }}</span>
            <h1>Votre commande attend son paiement</h1>
            <p class="lead">La commande <span class="order-number">{{ order.orderNumber }}</span> est enregistrée et vos articles sont réservés pendant deux heures.</p>
        {% endif %}
    </div>

    <div class="section">
        <section class="panel" aria-labelledby="contenu-commande">
            <h2 id="contenu-commande">Contenu de la commande</h2>
            {{ include('order/_summary.html.twig') }}
            <dl class="totals totals--after-lines">
                <div><dt>Livraison</dt><dd>Offerte</dd></div>
                <div class="totals__grand"><dt>Total</dt><dd>{{ order.total|eur }}</dd></div>
            </dl>
            {% if order.awaitingPayment %}
                {{ include('order/_pay.html.twig') }}
            {% endif %}
        </section>

        <section class="panel" aria-labelledby="livraison-commande">
            <h2 id="livraison-commande">Livraison</h2>
            <p>{{ order.shippingAddress }}</p>
        </section>

        <div class="form-actions">
            <a href="{{ path('app_order_show', {id: order.id}) }}" class="btn btn--quiet">Suivre cette commande</a>
            <a href="{{ path('app_product_index') }}" class="btn btn--quiet">Continuer mes achats</a>
        </div>
    </div>
</div>
{% endblock %}
