{% extends 'base.html.twig' %}

{% block title %}Mon panier · Binux Shop{% endblock %}

{% block body %}
<div class="wrap">
    <header class="page-head">
        <h1>Mon panier</h1>
        {% if cart.items|length > 0 %}
            <ol class="steps" aria-label="Étapes de la commande">
                <li aria-current="step">Panier</li>
                <li>Livraison</li>
                <li>Paiement</li>
            </ol>
        {% endif %}
    </header>

    {% if cart.items|length > 0 %}
    <div class="split">
        <section class="panel" aria-label="Articles du panier">
            <ul class="lines">
                {% for item in cart.items %}
                <li class="line">
                    <a class="thumb thumb--sm" href="{{ path('app_product_show', {slug: item.product.slug}) }}" tabindex="-1" aria-hidden="true">
                        <span class="thumb__mono">{{ item.product.name|first|upper }}</span>
                        {% if item.product.imageUrl %}<img src="{{ item.product.imageUrl }}" alt="" loading="lazy" data-img>{% endif %}
                    </a>
                    <div>
                        <a class="line__name" href="{{ path('app_product_show', {slug: item.product.slug}) }}">{{ item.product.name }}</a>
                        <p class="line__meta">{{ item.product.category.name }}, {{ item.price|eur }} l'unité</p>
                    </div>
                    <p class="line__total">{{ item.total|eur }}</p>
                    <div class="line__controls">
                        <form method="post" action="{{ path('app_cart_update', {id: item.id}) }}" data-autosubmit>
                            <input type="hidden" name="_token" value="{{ csrf_token('cart_update_' ~ item.id) }}">
                            <div class="stepper">
                                <button type="button" data-step="-1" aria-label="Diminuer la quantité de {{ item.product.name }}">{{ icon('minus', 'icon--sm') }}</button>
                                <label class="sr-only" for="qte-{{ item.id }}">Quantité de {{ item.product.name }}</label>
                                <input type="number" id="qte-{{ item.id }}" name="quantity" value="{{ item.quantity }}" min="1" max="{{ min(item.product.stock, max_quantity) }}" inputmode="numeric">
                                <button type="button" data-step="1" aria-label="Augmenter la quantité de {{ item.product.name }}">{{ icon('plus', 'icon--sm') }}</button>
                            </div>
                            <noscript><button class="btn btn--sm btn--quiet" type="submit">Mettre à jour</button></noscript>
                        </form>
                        <form method="post" action="{{ path('app_cart_remove', {id: item.id}) }}">
                            <input type="hidden" name="_token" value="{{ csrf_token('cart_remove_' ~ item.id) }}">
                            <button type="submit" class="link-button">Retirer<span class="sr-only"> {{ item.product.name }} du panier</span></button>
                        </form>
                    </div>
                </li>
                {% endfor %}
            </ul>
        </section>

        <aside class="panel panel--sticky" aria-labelledby="resume">
            <h2 id="resume">Résumé de la commande</h2>
            <dl class="totals">
                <div><dt>Sous-total, {{ cart.totalItems }} article{{ cart.totalItems > 1 ? 's' }}</dt><dd>{{ cart.total|eur }}</dd></div>
                <div><dt>Livraison</dt><dd>Offerte</dd></div>
                <div class="totals__grand"><dt>Total</dt><dd>{{ cart.total|eur }}</dd></div>
            </dl>
            <a href="{{ path('app_order_create') }}" class="btn btn--block">Commander</a>
            <p class="fine">{{ icon('lock', 'icon--sm') }}Le paiement se fait à l'étape suivante, sur la page sécurisée de Stripe.</p>
            <form method="post" action="{{ path('app_cart_clear') }}" data-confirm="Vider entièrement le panier ?">
                <input type="hidden" name="_token" value="{{ csrf_token('cart_clear') }}">
                <p class="fine"><button type="submit" class="link-button">Vider le panier</button></p>
            </form>
        </aside>
    </div>
    {% else %}
    <div class="empty">
        {{ icon('shopping-bag') }}
        <h2>Votre panier est vide</h2>
        <p>Faites un tour en boutique&nbsp;: tout ce qui est affiché en stock peut partir aujourd'hui.</p>
        <a href="{{ path('app_product_index') }}" class="btn">Voir les articles</a>
    </div>
    {% endif %}
</div>
{% endblock %}
