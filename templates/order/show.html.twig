{% extends 'account/_layout.html.twig' %}

{% block title %}Commande {{ order.orderNumber }} · Binux Shop{% endblock %}
{% block account_title %}Commande <span class="order-number">{{ order.orderNumber }}</span>{% endblock %}
{% set account_section = 'orders' %}

{% block account_body %}
    <div class="stack">
        <section class="panel" aria-labelledby="suivi">
            <h2 id="suivi">Suivi</h2>
            {% if order.cancelled %}
                <p class="note note--warn">{{ icon('circle-x') }}<span>Cette commande est annulée. Ses articles ont été remis en vente.</span></p>
            {% else %}
                {% set reached = {pending: 1, processing: 2, shipped: 3, delivered: 4}[order.status] ?? 1 %}
                <ol class="track">
                    <li class="is-done{{ reached == 1 ? ' is-last' }}">Commande passée <small>{{ order.createdAt|date('d/m/Y à H:i') }}</small></li>
                    <li class="{{ reached >= 2 ? 'is-done' }}{{ reached == 2 ? ' is-last' }}">Paiement reçu {% if order.payment and order.payment.paidAt %}<small>{{ order.payment.paidAt|date('d/m/Y à H:i') }}</small>{% endif %}</li>
                    <li class="{{ reached >= 3 ? 'is-done' }}{{ reached == 3 ? ' is-last' }}">Expédiée</li>
                    <li class="{{ reached >= 4 ? 'is-done' }}">Livrée</li>
                </ol>
            {% endif %}
        </section>

        <section class="panel" aria-labelledby="articles">
            <h2 id="articles">Articles commandés</h2>
            {{ include('order/_summary.html.twig') }}
            <dl class="totals totals--after-lines">
                <div><dt>Sous-total</dt><dd>{{ order.total|eur }}</dd></div>
                <div><dt>Livraison</dt><dd>Offerte</dd></div>
                <div class="totals__grand"><dt>Total</dt><dd>{{ order.total|eur }}</dd></div>
            </dl>

            {% if order.awaitingPayment %}
                {{ include('order/_pay.html.twig') }}
                <form method="post" action="{{ path('app_order_cancel', {id: order.id}) }}" data-confirm="Annuler cette commande ?" data-confirm-text="Ses articles seront remis en vente. Rien n'a été débité." data-confirm-action="Annuler la commande" data-confirm-cancel="Garder ma commande">
                    <input type="hidden" name="_token" value="{{ csrf_token('order_cancel_' ~ order.id) }}">
                    <p class="fine"><button type="submit" class="link-button">Annuler cette commande</button></p>
                </form>
            {% endif %}
        </section>

        <section class="panel" aria-labelledby="livraison">
            <h2 id="livraison">Livraison</h2>
            <dl class="kv">
                <div><dt>Adresse</dt><dd>{{ order.shippingAddress }}</dd></div>
                {% if order.notes %}<div><dt>Notes</dt><dd>{{ order.notes }}</dd></div>{% endif %}
            </dl>
        </section>

        <p><a href="{{ path('app_order_list') }}">Retour à mes commandes</a></p>
    </div>
{% endblock %}
