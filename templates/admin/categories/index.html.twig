{% extends 'admin/_layout.html.twig' %}

{% block title %}Catégories · Administration{% endblock %}
{% block admin_title %}Catégories{% endblock %}
{% block admin_intro %}<p>Les rayons de la boutique.</p>{% endblock %}
{% block admin_actions %}<a href="{{ path('app_admin_category_add') }}" class="btn btn--sm">{{ icon('plus') }} Ajouter une catégorie</a>{% endblock %}
{% set admin_section = 'categories' %}

{% block admin_body %}
<section class="panel panel--flush">
    {% if categories|length > 0 %}
    <div class="table-wrap">
        <table class="table">
            <thead>
                <tr><th scope="col">Catégorie</th><th scope="col" class="num">Produits</th><th scope="col"><span class="sr-only">Actions</span></th></tr>
            </thead>
            <tbody>
                {% for category in categories %}
                <tr>
                    <td>
                        <div class="cell-product">
                            <span class="thumb thumb--sm">
                                <span class="thumb__mono">{{ category.name|first|upper }}</span>
                                {% if category.imageUrl %}<img src="{{ category.imageUrl }}" alt="" loading="lazy" data-img>{% endif %}
                            </span>
                            <div>
                                <a class="line__name" href="{{ path('app_admin_category_edit', {id: category.id}) }}">{{ category.name }}</a>
                                <p class="line__meta">{{ category.description }}</p>
                            </div>
                        </div>
                    </td>
                    <td class="num">{{ category.products|length }}</td>
                    <td>
                        <div class="cell-actions">
                            <a href="{{ path('app_admin_category_edit', {id: category.id}) }}">Modifier</a>
                            <form method="post" action="{{ path('app_admin_category_delete', {id: category.id}) }}" data-confirm="Supprimer la catégorie « {{ category.name }} » ?" data-confirm-text="Une catégorie qui contient encore des produits ne peut pas être supprimée." data-confirm-action="Supprimer">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete_category_' ~ category.id) }}">
                                <button type="submit" class="link-button">Supprimer</button>
                            </form>
                        </div>
                    </td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
    {% else %}
    <div class="empty">
        {{ icon('tags') }}
        <h2>Aucune catégorie</h2>
        <p>Créez un premier rayon avant d'ajouter des produits.</p>
        <a href="{{ path('app_admin_category_add') }}" class="btn">Ajouter une catégorie</a>
    </div>
    {% endif %}
</section>
{% endblock %}
