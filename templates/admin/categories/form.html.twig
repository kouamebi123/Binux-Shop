{% extends 'admin/_layout.html.twig' %}

{% block title %}{{ title }} · Administration{% endblock %}
{% block admin_title %}{{ title }}{% endblock %}
{% block admin_actions %}<a href="{{ path('app_admin_categories') }}" class="btn btn--sm btn--quiet">Retour aux catégories</a>{% endblock %}
{% set admin_section = 'categories' %}

{% block admin_body %}
{{ form_start(form) }}
{{ form_errors(form) }}
<div class="admin__narrow">
    <section class="panel">
        <h2>Présentation</h2>
        {{ form_row(form.name) }}
        {{ form_row(form.description) }}
    </section>
    <section class="panel">
        <h2>Image</h2>
        {{ form_row(form.imageFile, {help: 'JPG, PNG, WebP ou GIF, 5 Mo au plus. Prioritaire sur l\'adresse ci-dessous.'}) }}
        {{ form_row(form.image, {help: 'Adresse https d\'une image hébergée ailleurs.'}) }}
    </section>
    <div class="form-actions">
        <button type="submit" class="btn">Enregistrer</button>
        <a href="{{ path('app_admin_categories') }}" class="btn btn--quiet">Annuler</a>
    </div>
</div>
{{ form_end(form) }}
{% endblock %}
