{% extends 'base.html.twig' %}

{% block title %}Livraison · Binux Shop{% endblock %}

{% block body %}
<div class="wrap">
    <header class="page-head">
        <h1>Finaliser ma commande</h1>
        <ol class="steps" aria-label="Étapes de la commande">
            <li class="is-done"><a href="{{ path('app_cart_index') }}">Panier</a></li>
            <li aria-current="step">Livraison</li>
            <li>Paiement</li>
        </ol>
    </header>

    {{ form_start(form, {attr: {novalidate: false}}) }}
    <div class="split">
        <div>
            <section class="panel" aria-labelledby="adresse">
                <h2 id="adresse">Adresse de livraison</h2>
                {{ form_errors(form) }}
                <div class="form-grid">
                    {{ form_row(form.address.street, {row_attr: {class: 'field--wide'}, attr: {autocomplete: 'address-line1'}}) }}
                    {{ form_row(form.address.complement, {row_attr: {class: 'field--wide'}, attr: {autocomplete: 'address-line2'}}) }}
                    {{ form_row(form.address.postalCode, {attr: {autocomplete: 'postal-code'}}) }}
                    {{ form_row(form.address.city, {attr: {autocomplete: 'address-level2'}}) }}
                    {{ form_row(form.address.country, {row_attr: {class: 'field--wide'}, attr: {autocomplete: 'country-name'}}) }}
                    {{ form_row(form.address.isDefault) }}
                </div>
            </section>

            <section class="panel" aria-labelledby="notes">
                <h2 id="notes">Un mot pour la livraison</h2>
                {{ form_row(form.notes, {label: 'Notes de commande', help: 'Code d\'accès, étage, créneau préféré.'}) }}
            </section>
        </div>

        <aside class="panel panel--sticky" aria-labelledby="recap">
            <h2 id="recap">Récapitulatif</h2>
            <ul class="lines">
                {% for item in cart.items %}
                <li class="line">
                    <span class="thumb thumb--sm">
                        <span class="thumb__mono">{{ item.product.name|first|upper }}</span>
                        {% if item.product.imageUrl %}<img src="{{ item.product.imageUrl }}" alt="" loading="lazy" data-img>{% endif %}
                    </span>
                    <div>
                        <p class="line__name">{{ item.product.name }}</p>
                        <p class="line__meta">{{ item.quantity }} × {{ item.price|eur }}</p>
                    </div>
                    <p class="line__total">{{ item.total|eur }}</p>
                </li>
                {% endfor %}
            </ul>
            <dl class="totals totals--after-lines">
                <div><dt>Sous-total</dt><dd>{{ cart.total|eur }}</dd></div>
                <div><dt>Livraison</dt><dd>Offerte</dd></div>
                <div class="totals__grand"><dt>Total à payer</dt><dd>{{ cart.total|eur }}</dd></div>
            </dl>
            <button type="submit" class="btn btn--block">{{ icon('lock') }} Valider et payer</button>
            <p class="fine">Vous serez dirigé vers la page de paiement de Stripe. Vos articles vous sont réservés pendant deux heures.</p>
        </aside>
    </div>
    {{ form_end(form) }}
</div>
{% endblock %}
