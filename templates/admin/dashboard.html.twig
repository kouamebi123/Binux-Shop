{% extends 'admin/_layout.html.twig' %}

{% block title %}Tableau de bord · Administration{% endblock %}
{% block admin_title %}Tableau de bord{% endblock %}
{% block admin_intro %}<p>L'activité de la boutique, à jour à l'instant.</p>{% endblock %}

{% block admin_body %}
<div class="stats">
    <div class="stat stat--hero">
        <p class="stat__label">Encaissé</p>
        <p class="stat__value">{{ figures.revenue_cents|cents }}</p>
        <p class="stat__note">{{ figures.paid_orders }} commande{{ figures.paid_orders > 1 ? 's' }} payée{{ figures.paid_orders > 1 ? 's' }}, hors annulations</p>
    </div>
    <div class="stat">
        <p class="stat__label">Panier moyen</p>
        <p class="stat__value">{{ average_cents|cents }}</p>
        <p class="stat__note">par commande payée</p>
    </div>
    <a class="stat stat--link" href="{{ path('app_admin_orders', {statut: 'processing'}) }}">
        <p class="stat__label">À préparer</p>
        <p class="stat__value">{{ figures.to_process }}</p>
        <p class="stat__note">payées, pas encore expédiées</p>
    </a>
    <a class="stat stat--link" href="{{ path('app_admin_orders', {statut: 'pending'}) }}">
        <p class="stat__label">En attente de paiement</p>
        <p class="stat__value">{{ figures.awaiting_payment }}</p>
        <p class="stat__note">annulées d'office après deux heures</p>
    </a>
</div>

{% set max = max(revenue_by_day)|default(0) %}
<section class="panel" aria-labelledby="graphique">
    <h2 id="graphique">Encaissements des 14 derniers jours</h2>
    {% if max > 0 %}
        {% set w = 68 %}{% set h = 150 %}{% set bw = 22 %}
        <div class="chart">
            <svg class="chart__svg" viewBox="0 0 {{ w * revenue_by_day|length }} {{ h + 26 }}" role="img" aria-label="Encaissements par jour sur 14 jours. Le détail figure dans le tableau ci-dessous.">
                <line class="chart__grid" x1="0" x2="{{ w * revenue_by_day|length }}" y1="{{ h }}" y2="{{ h }}"/>
                <line class="chart__grid chart__grid--soft" x1="0" x2="{{ w * revenue_by_day|length }}" y1="{{ h / 2 }}" y2="{{ h / 2 }}"/>
                <line class="chart__grid chart__grid--soft" x1="0" x2="{{ w * revenue_by_day|length }}" y1="1" y2="1"/>
                {% for day, cents in revenue_by_day %}
                    {% set bar = max((cents / max * (h - 6))|round, cents > 0 ? 5 : 0) %}
                    <g class="chart__col">
                        <rect class="chart__hit" x="{{ loop.index0 * w }}" y="0" width="{{ w }}" height="{{ h }}"/>
                        {% if cents > 0 %}
                            <path class="chart__bar{{ loop.last ? ' chart__bar--today' }}" d="M{{ loop.index0 * w + (w - bw) / 2 }} {{ h }} v-{{ max(bar - 4, 0) }} q0 -4 4 -4 h{{ bw - 8 }} q4 0 4 4 v{{ max(bar - 4, 0) }} z"/>
                        {% endif %}
                        <title>{{ day|date('d/m') }} : {{ cents|cents }}</title>
                        {% if loop.first or loop.last or loop.index0 % 3 == 0 %}
                            <text class="chart__tick" x="{{ loop.index0 * w + w / 2 }}" y="{{ h + 18 }}" text-anchor="middle">{{ day|date('d/m') }}</text>
                        {% endif %}
                    </g>
                {% endfor %}
            </svg>
            <p class="chart__scale">Barre la plus haute&nbsp;: {{ max|cents }}</p>
        </div>
        <details class="chart__table">
            <summary>Voir les chiffres jour par jour</summary>
            <div class="table-wrap">
                <table class="table">
                    <thead><tr><th scope="col">Jour</th><th scope="col" class="num">Encaissé</th></tr></thead>
                    <tbody>
                        {% for day, cents in revenue_by_day %}
                            <tr><td>{{ day|date('d/m/Y') }}</td><td class="num">{{ cents|cents }}</td></tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </details>
    {% else %}
        <p class="muted">Aucun encaissement sur la période. Le graphique apparaîtra avec le premier paiement.</p>
    {% endif %}
</section>

<div class="admin__cols">
    <section class="panel" aria-labelledby="recentes">
        <div class="panel__head">
            <h2 id="recentes">Dernières commandes</h2>
            <a href="{{ path('app_admin_orders') }}">Toutes les commandes</a>
        </div>
        {% if recent_orders|length > 0 %}
        <div class="table-wrap">
            <table class="table">
                <thead>
                    <tr><th scope="col">Commande</th><th scope="col">Client</th><th scope="col">État</th><th scope="col" class="num">Total</th></tr>
                </thead>
                <tbody>
                    {% for order in recent_orders %}
                    <tr>
                        <td><a class="order-number" href="{{ path('app_admin_order_show', {id: order.id}) }}">{{ order.orderNumber }}</a><br><span class="muted">{{ order.createdAt|date('d/m/Y H:i') }}</span></td>
                        <td>{{ order.user.fullName }}</td>
                        <td>{{ include('order/_status.html.twig') }}</td>
                        <td class="num">{{ order.total|eur }}</td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
        {% else %}
            <p class="muted">Aucune commande pour l'instant.</p>
        {% endif %}
    </section>

    <section class="panel" aria-labelledby="stock">
        <div class="panel__head">
            <h2 id="stock">Stock à surveiller</h2>
            <a href="{{ path('app_admin_products') }}">Tous les produits</a>
        </div>
        {% if low_stock|length > 0 %}
        <ul class="lines">
            {% for product in low_stock %}
            <li class="line">
                <span class="thumb thumb--sm">
                    <span class="thumb__mono">{{ product.name|first|upper }}</span>
                    {% if product.imageUrl %}<img src="{{ product.imageUrl }}" alt="" loading="lazy" data-img>{% endif %}
                </span>
                <div>
                    <a class="line__name" href="{{ path('app_admin_product_edit', {id: product.id}) }}">{{ product.name }}</a>
                    <p class="line__meta">{{ product.category.name }}</p>
                </div>
                <span class="tag {{ product.stock == 0 ? 'tag--bad' : 'tag--warn' }}">{{ product.stock == 0 ? 'Épuisé' : product.stock ~ ' restant' ~ (product.stock > 1 ? 's') }}</span>
            </li>
            {% endfor %}
        </ul>
        {% else %}
            <p class="muted">Tous les produits en vente ont plus de cinq exemplaires.</p>
        {% endif %}
        <p class="fine">{{ total_products }} produit{{ total_products > 1 ? 's' }} au catalogue, {{ total_users }} compte{{ total_users > 1 ? 's' }} client, {{ total_orders }} commande{{ total_orders > 1 ? 's' }} au total.</p>
    </section>
</div>
{% endblock %}
