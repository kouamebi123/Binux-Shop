{% extends 'base.html.twig' %}

{% block title %}{{ product.name }} - Binux Shop{% endblock %}

{% block body %}
<div class="bg-light py-3">
    <div class="container">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-0">
                <li class="breadcrumb-item"><a href="{{ path('app_home') }}">Accueil</a></li>
                <li class="breadcrumb-item"><a href="{{ path('app_product_index') }}">Produits</a></li>
                <li class="breadcrumb-item"><a href="{{ path('app_product_category', {slug: product.category.slug}) }}">{{ product.category.name }}</a></li>
                <li class="breadcrumb-item active">{{ product.name }}</li>
            </ol>
        </nav>
    </div>
</div>

<div class="container my-5">
    <div class="row">
        <div class="col-lg-6 mb-4">
            <div class="card">
                <img src="{{ product.imageUrl ?: 'https://via.placeholder.com/600x500?text=' ~ product.name }}" 
                     class="card-img-top" 
                     style="height: 500px; object-fit: cover;" 
                     alt="{{ product.name }}">
            </div>
        </div>

        <div class="col-lg-6">
            <h1 class="fw-bold mb-3">{{ product.name }}</h1>
            
            <div class="mb-3">
                <span class="badge bg-primary">{{ product.category.name }}</span>
                {% if product.hasDiscount %}
                    <span class="badge bg-danger">-{{ product.discountPercentage }}%</span>
                {% endif %}
                {% if not product.isInStock %}
                    <span class="badge bg-secondary">Rupture de stock</span>
                {% endif %}
            </div>

            <div class="mb-4">
                <div class="d-flex align-items-center gap-3">
                    <span class="h2 mb-0 text-primary">{{ product.price }} €</span>
                    {% if product.oldPrice %}
                        <span class="h4 mb-0 text-muted text-decoration-line-through">{{ product.oldPrice }} €</span>
                    {% endif %}
                </div>
            </div>

            {% if product.description %}
            <div class="mb-4">
                <h5 class="fw-bold">Description</h5>
                <p class="text-muted">{{ product.description }}</p>
            </div>
            {% endif %}

            <div class="mb-4">
                <h5 class="fw-bold">Disponibilité</h5>
                {% if product.isInStock %}
                    <p class="text-success">
                        <i class="bi bi-check-circle"></i> En stock ({{ product.stock }} disponibles)
                    </p>
                {% else %}
                    <p class="text-danger">
                        <i class="bi bi-x-circle"></i> Rupture de stock
                    </p>
                {% endif %}
            </div>

            {% if is_granted('IS_AUTHENTICATED_FULLY') and product.isInStock %}
            <form method="post" action="{{ path('app_cart_add', {id: product.id}) }}">
                <input type="hidden" name="_token" value="{{ csrf_token('cart_add_' ~ product.id) }}">
                <div class="mb-3">
                    <label for="quantity" class="form-label fw-bold">Quantité</label>
                    <input type="number" 
                           class="form-control" 
                           id="quantity" 
                           name="quantity" 
                           value="1" 
                           min="1" 
                           max="{{ product.stock }}" 
                           style="width: 100px;">
                </div>
                
                <button type="submit" class="btn btn-primary btn-lg px-5">
                    <i class="bi bi-cart-plus"></i> Ajouter au panier
                </button>
            </form>
            {% elseif not is_granted('IS_AUTHENTICATED_FULLY') %}
                <div class="alert alert-info">
                    <i class="bi bi-info-circle"></i> 
                    <a href="{{ path('app_login') }}">Connectez-vous</a> pour ajouter ce produit au panier
                </div>
            {% endif %}
        </div>
    </div>

    <!-- Related Products -->
    {% if related_products|length > 0 %}
    <section class="mt-5 pt-5 border-top">
        <h3 class="fw-bold mb-4">Produits similaires</h3>
        <div class="row g-4">
            {% for relatedProduct in related_products %}
            <div class="col-md-6 col-lg-3">
                <div class="card h-100">
                    <img src="{{ relatedProduct.imageUrl ?: 'https://via.placeholder.com/300x250?text=' ~ relatedProduct.name }}" 
                         class="card-img-top" alt="{{ relatedProduct.name }}">
                    <div class="card-body">
                        <h5 class="card-title">{{ relatedProduct.name }}</h5>
                        <div class="d-flex justify-content-between align-items-center">
                            <span class="h5 mb-0 text-primary">{{ relatedProduct.price }} €</span>
                            <a href="{{ path('app_product_show', {slug: relatedProduct.slug}) }}" class="btn btn-sm btn-outline-primary">
                                Voir
                            </a>
                        </div>
                    </div>
                </div>
            </div>
            {% endfor %}
        </div>
    </section>
    {% endif %}
</div>
{% endblock %}

