{% extends 'security/_layout.html.twig' %}

{% block title %}Créer un compte · Binux Shop{% endblock %}
{% block auth_aside %}Un compte suffit pour remplir un panier, commander et suivre chaque colis.{% endblock %}

{% block auth_body %}
    <h1>Créer un compte</h1>
    <p>Une minute, et la boutique est à vous.</p>

    {{ form_start(form) }}
    {{ form_errors(form) }}
    <div class="form-grid">
        {{ form_row(form.firstName, {attr: {autocomplete: 'given-name'}}) }}
        {{ form_row(form.lastName, {attr: {autocomplete: 'family-name'}}) }}
        {{ form_row(form.email, {row_attr: {class: 'field--wide'}, attr: {autocomplete: 'email'}}) }}
        {{ form_row(form.phone, {row_attr: {class: 'field--wide'}, attr: {autocomplete: 'tel'}}) }}
        {{ form_row(form.plainPassword.first, {row_attr: {class: 'field--wide'}}) }}
        {{ form_row(form.plainPassword.second, {row_attr: {class: 'field--wide'}}) }}
    </div>
    <button type="submit" class="btn btn--block">Créer mon compte</button>
    <p class="fine">Vos informations servent uniquement à traiter vos commandes. <a href="{{ path('app_about') }}#donnees">En savoir plus</a></p>
    {{ form_end(form) }}

    <p class="auth__alt">Déjà client&nbsp;? <a href="{{ path('app_login') }}">Se connecter</a></p>
{% endblock %}
