{% extends 'base.html.twig' %}

{% block title %}Gestion des commandes - Admin{% endblock %}

{% block body %}
<div class="bg-dark text-white py-4">
    <div class="container">
        <h1 class="fw-bold"><i class="bi bi-bag"></i> Gestion des commandes</h1>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb bg-transparent text-white-50 mb-0">
                <li class="breadcrumb-item"><a href="{{ path('app_admin_dashboard') }}" class="text-white-50">Admin</a></li>
                <li class="breadcrumb-item active text-white">Commandes</li>
            </ol>
        </nav>
    </div>
</div>

<div class="container my-5">
    {% if orders|length > 0 %}
    <div class="card">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th>Numéro</th>
                            <th>Client</th>
                            <th>Date</th>
                            <th>Total</th>
                            <th>Paiement</th>
                            <th>Statut</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for order in orders %}
                        <tr>
                            <td>{{ order.orderNumber }}</td>
                            <td>{{ order.user.fullName }}</td>
                            <td>{{ order.createdAt|date('d/m/Y H:i') }}</td>
                            <td>{{ order.total }} €</td>
                            <td>
                                {% if order.isPaid %}
                                    <span class="badge bg-success">
                                        <i class="bi bi-check-circle"></i> Payée
                                    </span>
                                {% else %}
                                    <span class="badge bg-danger">
                                        <i class="bi bi-x-circle"></i> Non payée
                                    </span>
                                {% endif %}
                            </td>
                            <td>
                                {% set statusClass = {
                                    'pending': 'warning',
                                    'processing': 'info',
                                    'shipped': 'primary',
                                    'delivered': 'success',
                                    'cancelled': 'danger'
                                } %}
                                <span class="badge bg-{{ statusClass[order.status] ?? 'secondary' }}">
                                    {{ order.statusLabel }}
                                </span>
                            </td>
                            <td>
                                <a href="{{ path('app_admin_order_show', {id: order.id}) }}" class="btn btn-sm btn-outline-primary">
                                    <i class="bi bi-eye"></i> Voir
                                </a>
                            </td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    {% else %}
    <div class="alert alert-info">Aucune commande trouvée</div>
    {% endif %}
</div>
{% endblock %}

