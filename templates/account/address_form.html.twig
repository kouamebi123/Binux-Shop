{% extends 'account/_layout.html.twig' %}

{% block title %}{{ title }} · Binux Shop{% endblock %}
{% block account_title %}{{ title }}{% endblock %}
{% set account_section = 'addresses' %}

{% block account_body %}
    <section class="panel">
        {{ form_start(form) }}
        {{ form_errors(form) }}
        <div class="form-grid">
            {{ form_row(form.street, {row_attr: {class: 'field--wide'}, attr: {autocomplete: 'address-line1'}}) }}
            {{ form_row(form.complement, {row_attr: {class: 'field--wide'}, attr: {autocomplete: 'address-line2'}}) }}
            {{ form_row(form.postalCode, {attr: {autocomplete: 'postal-code'}}) }}
            {{ form_row(form.city, {attr: {autocomplete: 'address-level2'}}) }}
            {{ form_row(form.country, {row_attr: {class: 'field--wide'}, attr: {autocomplete: 'country-name'}}) }}
            {{ form_row(form.isDefault) }}
        </div>
        <div class="form-actions">
            <button type="submit" class="btn">Enregistrer</button>
            <a href="{{ path('app_account_addresses') }}" class="btn btn--quiet">Annuler</a>
        </div>
        {{ form_end(form) }}
    </section>
{% endblock %}
